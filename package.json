{
  "name": "kimland-shopify-sync",
  "version": "1.0.0",
  "description": "Professional Product Sync from Kimland to Shopify",
  "main": "electron-main.js",
  "node": "20.x",
  "scripts": {
    "start": "node src/index.js",
    "dev": "npx kill-port 3001 && nodemon --ignore '*.json' --ignore 'product-*.json' --ignore 'logs/*' src/index.js",
    "electron": "electron .",
    "build": "npm run build:electron && npm run build:pkg",
    "build:electron": "electron-builder",
    "build:pkg": "pkg . --targets node18-win-x64 --output dist/kimland-sync.exe",
    "build:win": "electron-builder --win",
    "test": "node test-simple.js",
    "test:smoke": "node tests/shopify-client.test.js"
    },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "json2csv": "^6.0.0-alpha.2",
    "playwright": "^1.61.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "kill-port": "^2.0.1",
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  },
  "build": {
    "appId": "com.kimland.sync",
    "productName": "Kimland Shopify Sync",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "assets/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "pkg": {
    "assets": [
      "src/views/**/*",
      "public/**/*",
      "assets/**/*"
    ],
    "scripts": [
      "src/**/*.js"
    ]
  }
}
